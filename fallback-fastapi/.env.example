# 複製為同目錄的 .env 後填入自己的金鑰；不要提交真實金鑰。
# .env 的設定會覆蓋同名的程序環境變數。
# 只使用 CPU embedding 時不需要金鑰；留空時對應的雲端轉送不可用。
COHERE_API_KEY=
JEV_API_KEY=

# 以下為選填設定，註解中的值與程式預設值相同。
# CPU embedding：不支援 bf16 的環境可改為 fp32。
# FALLBACK_MODEL_ID=voyageai/voyage-4-nano
# FALLBACK_SERVED_NAME=voyage-4-nano
# FALLBACK_DTYPE=bf16

# 雲端 reranker 與 decision 的端點、模型。
# COHERE_RERANK_URL=https://api.cohere.com/v2/rerank
# COHERE_RERANK_MODEL=rerank-v4.0-fast
# JEV_URL=https://api.typesafe.ai/v1/systemone
# JEV_MODEL=jev-1.14.0

# 雲端 HTTP 請求逾時秒數。
# FALLBACK_UPSTREAM_TIMEOUT=60
